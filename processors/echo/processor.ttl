@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix :     <https://w3id.org/rdf-connect/rust#> .

# `generated.ttl` doesn't exist until this crate is built (`cargo build`
# runs `build.rs`, which regenerates it every time via
# `rdfc-processor-buildtools`) — it carries this class's `:abiStable` token
# and `:artifact` table, always in sync with the actual compiled `cdylib`.
# Never hand-edit it; it's gitignored.
<> owl:imports <generated.ttl> .

rdfc:EchoProcessor a rdfc:Processor ;
    rdfs:label "Echo Processor" ;
    :rustImplementationOf rdfc:Processor .

[ ] a sh:NodeShape ;
    sh:targetClass rdfc:EchoProcessor ;
    sh:property [
        sh:path rdfc:reader ;
        sh:name "reader" ;
        sh:class rdfc:Reader ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] , [
        sh:path rdfc:writer ;
        sh:name "writer" ;
        sh:class rdfc:Writer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
