@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <https://w3id.org/rdf-connect/rust#> .

rdfc:LogProcessor a rdfc:Processor ;
    rdfs:label "Log Processor" ;
    :rustImplementationOf rdfc:Processor ;
    :abiStable "rdfc-processor-sdk-0.1.0+abi_stable-0.11.3+async-ffi-0.5.0" ;
    :artifact [
        # Built locally via `cargo build --workspace --release`; path is
        # relative to this file. A pipeline uses this processor by
        # `owl:import`ing this file directly — see examples/echo-pipeline.
        :targetTriple "x86_64-unknown-linux-gnu" ;
        :path         <../../target/release/librdfc_processor_log.so> ;
        :sha256       "94c58b42da87a9611d51a0918770a536aac45feaaea5fe06496ac243c7c1a3f1" ;
    ] .

[ ] a sh:NodeShape ;
    sh:targetClass rdfc:LogProcessor ;
    sh:property [
        sh:path rdfc:reader ;
        sh:name "reader" ;
        sh:class rdfc:Reader ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] , [
        sh:path rdfc:label ;
        sh:name "label" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .
