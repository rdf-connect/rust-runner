@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix : <https://w3id.org/rdf-connect/rust#>.

# ── Runner definition ─────────────────────────────────────────────────────────
rdfc:RustRunner a rdfc:Runner;
  rdfc:handlesSubjectsOf :rustImplementationOf;
  rdfc:command "rust-runner".

# ── Processor config shape ─────────────────────────────────────────────────────
#
# Applies generically to every class that opts into the Rust runner via
# `:rustImplementationOf rdfc:Processor` — there is no per-processor
# declaration here. A processor's own `processor.ttl` (see e.g.
# processors/echo/processor.ttl or kolibrie-processor/processor.ttl) declares
# its `:abiStable` token and `:artifact` list on its own class; a pipeline
# picks up both that data *and* the processor's argument shape simply by
# `owl:import`ing that file — nothing else is needed.
#
# The orchestrator resolves `:path` (declared as an IRI in each `:artifact`
# entry, so relative references resolve against wherever the enclosing file
# was fetched from) but hands it to the runner as a plain string — see the
# `sh:datatype xsd:string` below despite `:path`'s value being an IRI.
[ ] a sh:NodeShape;
  sh:targetSubjectsOf :rustImplementationOf;
  sh:property [
    sh:path :abiStable;
    sh:name "abi_token";
    sh:maxCount 1;
    sh:datatype xsd:string;
  ], [
    sh:path :artifact;
    sh:name "artifacts";
    sh:class :Artifact;
  ].

[ ] a sh:NodeShape;
  sh:targetClass :Artifact;
  sh:property [
    sh:path :targetTriple;
    sh:name "target_triple";
    sh:datatype xsd:string;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path :path;
    sh:name "path";
    sh:datatype xsd:string;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path :sha256;
    sh:name "sha256";
    sh:datatype xsd:string;
    sh:maxCount 1;
  ].
